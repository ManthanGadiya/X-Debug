# Copy to .env and adjust as needed. All variables are optional; defaults live
# in app/core/config.py.

XDEBUG_ENVIRONMENT=development
XDEBUG_DEBUG=false
XDEBUG_API_PREFIX=/api/v1
XDEBUG_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
XDEBUG_LOG_LEVEL=INFO

# Storage layer (used from the storage roadmap phase onward).
XDEBUG_DATABASE_URL=postgresql://xdebug:xdebug@localhost:5432/xdebug
XDEBUG_NEO4J_URI=bolt://localhost:7687
XDEBUG_NEO4J_USER=neo4j
XDEBUG_NEO4J_PASSWORD=xdebug

# Analysis limits.
XDEBUG_MAX_REPOSITORY_SIZE_MB=200
XDEBUG_ANALYSIS_TIMEOUT_SECONDS=300
